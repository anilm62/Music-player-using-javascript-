body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    background: #f0f0f0;
    font-family: Arial, sans-serif;
}

.player-container {
    background: white;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
    width: 300px;
    text-align: center;
}

.album-art img {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    margin-bottom: 1rem;
}

.song-info {
    margin-bottom: 1rem;
}

.progress-container {
    background: #ddd;
    height: 4px;
    border-radius: 2px;
    margin: 1rem 0;
    cursor: pointer;
}

.progress-bar {
    height: 100%;
    background: #4CAF50;
    width: 0%;
    border-radius: 2px;
    transition: width 0.1s linear;
}

.controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
}

.btn {
    padding: 0.5rem 1rem;
    border: none;
    background: #4CAF50;
    color: white;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1.2rem;
}

.btn:hover {
    background: #45a049;
}
